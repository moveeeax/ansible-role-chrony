## {{ ansible_managed }}
## chrony configuration managed by ansible-role-chrony.

{# Set by tasks/cloud.yml; "none" when the template is rendered on its own. #}
{% set chrony_cloud = chrony_cloud_time_source_resolved | default('none') %}
{% if chrony_cloud == 'aws' %}
# Amazon Time Sync Service on the instance's link-local address.
server 169.254.169.123 prefer iburst minpoll 4 maxpoll 4
# Public Amazon Time Sync Service as a backup.
pool time.aws.com iburst

{% elif chrony_cloud == 'gcp' %}
# Compute Engine metadata server time service.
server metadata.google.internal iburst

{% elif chrony_cloud == 'azure' %}
# Azure host clock exposed by Hyper-V as a PTP device.
refclock PHC {{ chrony_azure_ptp_device }} poll 3 dpoll -2 offset 0 stratum 2

{% endif %}
{% if chrony_cloud == 'none' or not (chrony_cloud_time_source_exclusive | bool) %}
{% for server in chrony_servers %}
{% if server is mapping %}
server {{ server.name }}{% if server.options is defined %} {{ server.options }}{% endif %}

{% else %}
server {{ server }} iburst
{% endif %}
{% endfor %}
{% for pool in chrony_pools %}
{% if pool is mapping %}
pool {{ pool.name }}{% if pool.options is defined %} {{ pool.options }}{% endif %}

{% else %}
pool {{ pool }} iburst
{% endif %}
{% endfor %}
{% endif %}

# Record the rate at which the system clock gains or loses time.
driftfile {{ chrony_driftfile }}

{% if chrony_makestep_updates | int > 0 %}
# Step the clock for the first few updates if the offset is large.
makestep {{ chrony_makestep_threshold }} {{ chrony_makestep_updates }}
{% endif %}
{% if chrony_rtcsync | bool %}
# Enable kernel synchronisation of the real-time clock.
rtcsync
{% endif %}
{% if chrony_allow | length > 0 %}

# Networks permitted to use this host as an NTP server.
{% for network in chrony_allow %}
allow {{ network }}
{% endfor %}
{% endif %}
{% if chrony_local_stratum | int > 0 %}
# Serve time even when not synchronised to an upstream source.
local stratum {{ chrony_local_stratum }}
{% endif %}
{% if chrony_extra_config | length > 0 %}

# Additional directives supplied via chrony_extra_config.
{% for line in chrony_extra_config %}
{{ line }}
{% endfor %}
{% endif %}
